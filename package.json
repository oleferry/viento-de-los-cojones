{
  "name": "ondivento",
  "version": "0.1.0",
  "private": true,
  "description": "Planificador de rutas en bici optimizadas segun el viento",
  "scripts": {
    "db:setup": "node scripts/db-setup.mjs",
    "maplibre:worker": "node scripts/copy-maplibre-worker.mjs",
    "predev": "npm run maplibre:worker",
    "dev": "next dev",
    "prebuild": "npm run maplibre:worker",
    "build": "next build",
    "build:check": "node -e \"process.env.NEXT_DIST_DIR='.next-check';require('child_process').execSync('next build',{stdio:'inherit',env:process.env})\"",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@auth/pg-adapter": "^1.11.3",
    "maplibre-gl": "^6.3.0",
    "next": "^16.3.1",
    "next-auth": "^5.0.0-beta.32",
    "pg": "^8.23.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.2.0",
    "@types/pg": "^8.21.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "postcss": "^8.5.26",
    "puppeteer": "^25.7.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2"
  }
}
