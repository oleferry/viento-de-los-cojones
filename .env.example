# --- Routing ---
# Opcional pero MUY recomendable. Sin esta clave la app enruta con servidores
# publicos gratuitos: funciona, pero pierde el reparto de firme y con ello la
# garantia de que "carretera" sea 100% carretera.
# Clave gratuita en https://openrouteservice.org/dev/#/signup (2.000/dia)
ORS_API_KEY=

# Proveedor preferido: "ors" | "brouter" | "osrm". Por defecto se encadenan
# solos por latencia medida; esto es solo para forzar uno concreto.
ROUTING_PROVIDER=


# --- Cuentas (todo opcional) ---
# NADA de lo que hay debajo hace falta para planificar una ruta. Sin esto la app
# funciona igual y guarda el perfil en el navegador; las cuentas solo anaden
# poder usarla desde el movil y el ordenador con lo mismo.

# 1) Base de datos. En Vercel: Storage -> Create Database -> Postgres, conectala
#    al proyecto, y luego `npx vercel env pull .env.local`.
#    Despues, una vez: `npm run db:setup`
DATABASE_URL=

# 2) Secreto de sesion. Generalo con: npx auth secret
AUTH_SECRET=

# 3) Al menos un proveedor de acceso. Con los dos, salen los dos botones.
#    Google: https://console.cloud.google.com/apis/credentials
#    URI de redireccion autorizada:
#      https://TU-DOMINIO/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

#    Enlace por correo, sin contrasena: https://resend.com (nivel gratuito)
#    La MISMA clave sirve para el enlace de acceso y para los avisos de viento.
AUTH_RESEND_KEY=
AUTH_EMAIL_FROM=no-reply@tudominio.es


# --- Avisos de viento por correo (opcional) ---
# Protege /api/cron/wind-digest, el trabajo que revisa las rutas con aviso
# activado y escribe cuando aparece una buena ventana de viento. Vercel manda
# esta cabecera solo en sus propias llamadas de cron; una peticion de fuera sin
# el secreto recibe 401. Sin definirlo el endpoint queda ABIERTO, asi que en
# produccion ponlo. Generalo con: openssl rand -base64 32
#
# El cron va una vez al dia (ver vercel.json): el plan Hobby de Vercel rechaza
# el despliegue entero si corre mas veces.
CRON_SECRET=
