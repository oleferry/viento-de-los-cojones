# --- Routing ---
# Opcional pero MUY recomendable. Sin esta clave la app usa el OSRM publico de
# FOSSGIS (funciona, pero sin perfiles de carretera/camino ni datos de firme).
# Clave gratuita en https://openrouteservice.org/dev/#/signup (2.000 peticiones/dia)
ORS_API_KEY=

# Proveedor preferido: "ors" | "osrm" | "auto" (por defecto auto: ors si hay clave)
ROUTING_PROVIDER=auto
